NODE_ENV=production
APP_VERSION=dev

# PostgreSQL：生产环境必须替换默认密码。
POSTGRES_DB=ai_ops
POSTGRES_USER=ai_ops
POSTGRES_PASSWORD=change_me_with_a_strong_password

# AutoDL大模型通用基座唯一入口；未配置时使用确定性Mock，便于演示。
FOUNDATION_API_URL=
FOUNDATION_API_KEY=
FOUNDATION_APP_ID=ai-ops
FOUNDATION_TIMEOUT_MS=90000

# 可选数字人渲染服务。通用基座只生成课件脚本，不负责TTS/视频渲染。
DIGITAL_HUMAN_API_URL=
DIGITAL_HUMAN_API_KEY=
